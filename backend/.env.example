# ---------------------------------------------------------------------------
# Ajay AI Assistant — backend environment
# Copy to `.env` and fill in. Everything here has a safe default except keys.
# ---------------------------------------------------------------------------

# Service
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security — MUST be changed for production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=43200
CORS_ORIGINS=*

# Storage (SQLite by default; Firebase optional)
DB_PATH=./data/ajay.db
# FIREBASE_CREDENTIALS=./secrets/firebase-service-account.json

# AI brain — OpenAI compatible. Leave empty to run the offline rule engine.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_S=20
AI_MAX_HISTORY=12

# Networking
HTTP_TIMEOUT_S=12
