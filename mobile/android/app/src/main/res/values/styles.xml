<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the Flutter engine warms up: matches the app's dark theme
         so there is never a white flash on launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF04050C</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#FF04050C</item>
    </style>
</resources>
